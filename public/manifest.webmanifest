{
  "name": "Markdown Notes",
  "short_name": "Markdown Notes",
  "description": "Ghi chú Markdown cá nhân",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/markdown": [".md"],
        "text/plain": [".md"]
      }
    }
  ],
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "lang": "vi",
  "icons": [
    {
      "src": "/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
