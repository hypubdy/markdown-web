# Bản sao của .env.example — copy thành .env.local rồi sửa cho phù hợp.
# Mặc định Vite dev proxy mọi /api sang http://localhost:3000 (backend markdown-api).
# Muốn trỏ sang backend khác thì đổi VITE_API_TARGET.

# ── Clerk SSO (đăng nhập bằng Google/GitHub) ────────────────────────────────
# Có VITE_CLERK_PUBLISHABLE_KEY → app chuyển sang đăng nhập SSO qua Clerk
# (backend markdown-api phải chạy với AUTH_PROVIDER=clerk + CLERK_SECRET_KEY).
# Lấy key tại Clerk Dashboard → API Keys (cùng instance đang dùng ở backend).
# Bỏ trống để chạy chế độ cũ: form email/mật khẩu + JWT nội bộ (test/dev local).
VITE_CLERK_PUBLISHABLE_KEY=

VITE_API_TARGET=http://localhost:3000

# Bật để hiển thị Workspace beta và cho phép truy cập /workspace.
VITE_DEVELOPER_MODE=false
